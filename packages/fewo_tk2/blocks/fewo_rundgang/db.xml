<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.concrete5.org/doctrine-xml/0.5" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.concrete5.org/doctrine-xml/0.5 https://concretecms.github.io/doctrine-xml/doctrine-xml-0.5.xsd">
    <table name="btFewoRundgang">
        <field name="bID" type="integer">
            <unsigned/>
            <key/>
        </field>
        <field name="title" type="string" size="255">
            <default value=""/>
            <notnull/>
        </field>
        <!-- Räume, Startpositionen, Wegweiser und Hinweise aus dem Szenen-Editor (JSON, siehe FewoTk2\Tour\TourConfig) -->
        <field name="tour" type="text"/>
        <field name="previewFID" type="integer">
            <unsigned/>
            <default value="0"/>
            <notnull/>
        </field>
        <field name="autoLoad" type="boolean">
            <default value="1"/>
            <notnull/>
        </field>
        <field name="compass" type="boolean">
            <default value="0"/>
            <notnull/>
        </field>
        <field name="author" type="string" size="255">
            <default value=""/>
            <notnull/>
        </field>
        <field name="useCustomCode" type="boolean">
            <default value="0"/>
            <notnull/>
        </field>
        <field name="viewerCode" type="text"/>
        <field name="aspectRatio" type="string" size="16">
            <default value="3:2"/>
            <notnull/>
        </field>
        <field name="cssClass" type="string" size="64">
            <default value=""/>
            <notnull/>
        </field>
    </table>
</schema>
