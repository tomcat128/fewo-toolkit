<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.concrete5.org/doctrine-xml/0.5" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.concrete5.org/doctrine-xml/0.5 https://concretecms.github.io/doctrine-xml/doctrine-xml-0.5.xsd">
    <table name="btFewoChat">
        <field name="bID" type="integer">
            <unsigned/>
            <key/>
        </field>
        <field name="title" type="string" size="255">
            <default value=""/>
            <notnull/>
        </field>
        <!-- Begrüßung des Assistenten, erste Nachricht im Chat -->
        <field name="welcomeMessage" type="text"/>
        <!-- Beispielfragen zum Anklicken, je eine pro Zeile -->
        <field name="exampleQuestions" type="text"/>
        <!-- Hinweis unter dem Eingabefeld, z. B. dass eine KI antwortet -->
        <field name="notice" type="text"/>
    </table>
</schema>
