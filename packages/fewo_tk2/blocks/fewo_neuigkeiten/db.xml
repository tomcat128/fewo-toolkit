<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.concrete5.org/doctrine-xml/0.5" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.concrete5.org/doctrine-xml/0.5 https://concretecms.github.io/doctrine-xml/doctrine-xml-0.5.xsd">
    <table name="btFewoNeuigkeiten">
        <field name="bID" type="integer">
            <unsigned/>
            <key/>
        </field>
        <field name="apartmentID" type="integer">
            <unsigned/>
            <default value="0"/>
            <notnull/>
        </field>
        <field name="title" type="string" size="255">
            <default value=""/>
            <notnull/>
        </field>
        <!-- Bis Version 2.8 standen hier auch showPeriod und importanceLevels; seit 2.9 gelten sie für alle Blöcke
             (Dashboard › Neuigkeiten). Das Update übernimmt die Werte des zuletzt angelegten Blocks. -->
    </table>
</schema>
