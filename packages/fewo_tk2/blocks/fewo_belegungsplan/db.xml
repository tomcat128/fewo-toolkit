<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.concrete5.org/doctrine-xml/0.5" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.concrete5.org/doctrine-xml/0.5 https://concretecms.github.io/doctrine-xml/doctrine-xml-0.5.xsd">
    <table name="btFewoBelegungsplan">
        <field name="bID" type="integer">
            <unsigned/>
            <key/>
        </field>
        <field name="apartmentID" type="integer">
            <unsigned/>
            <default value="0"/>
            <notnull/>
        </field>
        <field name="title" type="string" size="255">
            <default value=""/>
            <notnull/>
        </field>
        <field name="monthsVisible" type="smallint">
            <unsigned/>
            <default value="4"/>
            <notnull/>
        </field>
        <field name="monthsTotal" type="smallint">
            <unsigned/>
            <default value="12"/>
            <notnull/>
        </field>
        <field name="onRequestKeywords" type="string" size="255">
            <default value=""/>
            <notnull/>
        </field>
        <field name="showLegend" type="boolean">
            <default value="1"/>
            <notnull/>
        </field>
    </table>
</schema>
