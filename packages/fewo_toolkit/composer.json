{
    "name": "fewobacher/fewo-toolkit",
    "description": "Fewo Toolkit – Concrete CMS package for holiday apartment websites",
    "type": "concretecms-package",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "sabre/vobject": "^4.5",
        "doctrine/collections": "^1.8 || ^2.0",
        "guzzlehttp/guzzle": "^7.8"
    },
    "autoload-dev": {
        "psr-4": {
            "FewoToolkit\\": "src/",
            "FewoToolkit\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
