<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.concrete5.org/doctrine-xml/0.5" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.concrete5.org/doctrine-xml/0.5 https://concretecms.github.io/doctrine-xml/doctrine-xml-0.5.xsd">
    <table name="btFewoPreisrechner">
        <field name="bID" type="integer">
            <unsigned/>
            <key/>
        </field>
        <field name="pricelistID" type="integer">
            <unsigned/>
            <default value="0"/>
            <notnull/>
        </field>
        <field name="calculationMode" type="string" size="16">
            <default value="arrival"/>
            <notnull/>
        </field>
        <field name="title" type="string" size="255">
            <default value=""/>
            <notnull/>
        </field>
        <field name="inquiryPageID" type="integer">
            <unsigned/>
            <default value="0"/>
            <notnull/>
        </field>
    </table>
</schema>
