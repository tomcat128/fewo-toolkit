<?xml version="1.0"?>
<schema version="0.3">
    <!-- DB-Table Blocktype FeWoBacher -->
    <table name="btFwbPreisrechner">
        <field name="bID" type="I">
            <key />
            <unsigned />
        </field>
        <field name="type" type="C" size="2">
            <default value="IN" />
        </field>
        <field name="preisliste" type="I">
            <default value="0" />
        </field>
        <!-- Modus bestimmt, ob fuer die Berechnung die Anreise oder der darauffolgende Tag ausschlaggebend ist -->
        <field name="modus" type="C" size="1">
            <default value="N" />
        </field>
        <field name="url_extern" type="C" size="255">
            <default value="http://" />
        </field>
    </table>
</schema>